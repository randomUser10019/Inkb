{
  "name": "@inkboard/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../.env --experimental-strip-types --import ./register.mjs src/server.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../.env --experimental-strip-types --import ./register.mjs src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --import ./register.mjs --test --test-force-exit 'src/**/*.test.ts' 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@inkboard/shared": "file:../shared",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@napi-rs/canvas": "^0.1.80",
    "typescript": "^5.7.0"
  }
}
